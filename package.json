{
  "name": "avirx",
  "version": "0.1.0",
  "description": "A TypeScript toolkit for fluent API requests.",
  "type": "module",
  "license": "MIT",
  "author": "zsumz <shawn@zsumz.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsumz/avirx.git"
  },
  "bugs": {
    "url": "https://github.com/zsumz/avirx/issues"
  },
  "homepage": "https://github.com/zsumz/avirx#readme",
  "keywords": [
    "http",
    "fetch",
    "client",
    "typescript",
    "fluent-api",
    "runtime-validation"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sallyport": {
    "requiredStatusChecks": [
      "Node 18.17 package compatibility",
      "Node 22",
      "Node 24",
      "Node 26"
    ]
  },
  "sideEffects": false,
  "files": [
    "dist",
    "avirx-logo.svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "architecture:check": "tsx scripts/architecture/check.mts",
    "browser:install": "playwright install --only-shell chromium",
    "build": "tsx scripts/build.mts",
    "build:archive-source": "tsx scripts/source-archive.ts",
    "check": "npm run check:code && npm test && npm run check:package",
    "check:code": "npm run typecheck && npm run lint && npm run architecture:check",
    "precheck:package": "npm run browser:install",
    "check:package": "npm run build && npm run smoke:package && npm run smoke:browser",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepublishOnly": "node -e \"throw new Error('Publish avirx only through .github/workflows/sallyport.yml.')\"",
    "release:check": "npm run check && npm run test:coverage && npm pack --dry-run --json",
    "release:smoke": "playwright install --with-deps --only-shell chromium && tsx scripts/release-smoke.mts",
    "smoke:browser": "tsx scripts/browser-smoke.mts",
    "smoke:package": "tsx scripts/package-smoke.mts"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-rubric": "^0.1.0-alpha.0",
    "playwright": "1.62.1",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
